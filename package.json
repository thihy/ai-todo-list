{
  "name": "todo-list",
  "version": "1.0.0-rc5",
  "private": true,
  "description": "AI-native Electron TODO list with Markdown content and Excalidraw drawings, built on DeepSeek Harness (DSH)",
  "appId": "com.todolist.app",
  "productName": "AI待办",
  "author": "todo-list",
  "copyright": "Copyright © 2026 todo-list",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:packaged-dsh": "electron resources/check-packaged-dsh.cjs",
    "e2e": "playwright test",
    "assets": "node resources/build-icons.mjs",
    "copy:excalidraw-fonts": "node resources/copy-excalidraw-fonts.mjs",
    "predev": "node resources/copy-excalidraw-fonts.mjs",
    "prebuild": "node resources/copy-excalidraw-fonts.mjs",
    "prepreview": "node resources/copy-excalidraw-fonts.mjs",
    "dist": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder",
    "dist:win": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win",
    "dist:mac": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac",
    "dist:linux": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --linux",
    "dist:dir": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --dir",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "audit": "pnpm audit --prod"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.17",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-base": "0.1.5-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.1.5-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title-first-prompt-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.5-rc.2",
    "@deepseek-ai/dsh-spill-policy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-call-timeout-policy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.5-rc.2",
    "@deepseek-ai/dsh-web": "0.1.5-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "0.85.1",
    "@excalidraw/excalidraw": "^0.18.0",
    "@nanmicoder/dsh-auto-mode": "0.1.9",
    "@shikijs/langs": "^4.4.3",
    "anser": "^2.3.5",
    "better-sqlite3": "^13.0.3",
    "clsx": "2.1.1",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "marked": "^16.4.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^11.17.2",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.3",
    "ulid": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "0.35.4",
    "@koromix/koffi-win32-x64": "3.2.1",
    "@vscode/ripgrep-win32-x64": "1.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.6",
    "dmg-builder": "^26.16.0",
    "cross-env": "^7.0.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.16.0",
    "electron-builder-squirrel-windows": "^26.16.0",
    "electron-vite": "^2.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^15.11.6",
    "playwright": "^1.49.0",
    "prettier": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "build": {
    "appId": "com.todolist.app",
    "productName": "AI待办",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "publish": {
      "provider": "generic",
      "url": "https://gitcode.com/ai-sea/ai-todo-list/releases/latest"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/node_modules/@img/sharp-darwin-*/**",
      "!**/node_modules/@img/sharp-linux*/**",
      "!**/node_modules/@img/sharp-libvips-darwin-*/**",
      "!**/node_modules/@img/sharp-libvips-linux*/**",
      "!**/node_modules/@img/sharp-libvips-linuxmusl-*/**",
      "!**/node_modules/@img/sharp-wasm32/**",
      "!**/node_modules/@img/sharp-webcontainers-wasm32/**",
      "!**/node_modules/@img/sharp-freebsd-*/**",
      "!**/node_modules/@img/sharp-win32-ia32/**",
      "!**/node_modules/@img/sharp-win32-arm64/**",
      "!**/node_modules/@vscode/ripgrep-darwin-*/**",
      "!**/node_modules/@vscode/ripgrep-linux-*/**",
      "!**/node_modules/@vscode/ripgrep-win32-arm64/**",
      "!**/node_modules/@vscode/ripgrep-win32-ia32/**"
    ],
    "extraResources": [
      {
        "from": "resources/dsh",
        "to": "dsh"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ai-todo-list-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI待办"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
